import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp

# Chua's diode piecewise-linear function
def chua_diode(x, m0, m1):
    return m1 * x + 0.5 * (m0 - m1) * (np.abs(x + 1) - np.abs(x - 1))

# Chua's circuit equations
def chua_circuit(t, state, alpha, beta, m0, m1):
    x, y, z = state
    dx = alpha * (y - x - chua_diode(x, m0, m1))
    dy = x - y + z
    dz = -beta * y
    return [dx, dy, dz]

# Parameters
alpha = 15.6
beta = 28.0
m0 = -1.143
m1 = -0.714

# Initial conditions
initial_state = [0.7, 0.0, 0.0]
t_span = (0, 100)
t_eval = np.linspace(*t_span, 10000)

# Solve the system
solution = solve_ivp(chua_circuit, t_span, initial_state, t_eval=t_eval, args=(alpha, beta, m0, m1))

# Plot the results
fig = plt.figure(figsize=(12, 6))
ax = fig.add_subplot(121, projection='3d')
ax.plot(solution.y[0], solution.y[1], solution.y[2], lw=0.5)
ax.set_title("Chua's Attractor (3D)")
ax.set_xlabel('x')
ax.set_ylabel('y')
ax.set_zlabel('z')

plt.subplot(122)
plt.plot(solution.t, solution.y[0], label='x(t)', alpha=0.7)
plt.plot(solution.t, solution.y[1], label='y(t)', alpha=0.7)
plt.plot(solution.t, solution.y[2], label='z(t)', alpha=0.7)
plt.title("Time Series")
plt.xlabel("Time")
plt.ylabel("Amplitude")
plt.legend()

plt.tight_layout()
plt.show()
